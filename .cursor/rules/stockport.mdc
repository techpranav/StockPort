## Common Patterns

### Data Fetching Pattern
```python
def fetch_with_retry(symbol: str, max_retries: int = 3) -> StockData:
    """Fetch data with automatic retry."""
    for attempt in range(max_retries):
        try:
            return provider.fetch(symbol)
        except DataFetchException as e:
            if attempt == max_retries - 1:
                raise
            DebugUtils.warning(f"Retry {attempt + 1}/{max_retries} for {symbol}")
            time.sleep(2 ** attempt)  # Exponential backoff
    raise DataFetchException(f"Failed after {max_retries} attempts")
```

### Indicator Calculation Pattern
```python
def calculate_indicator(
    data: pd.DataFrame,
    indicator_name: str,
    **params
) -> pd.Series:
    """Calculate indicator with validation."""
    # Validate input
    if data.empty:
        raise DataProcessingException("Data cannot be empty")
    if 'Close' not in data.columns:
        raise DataProcessingException("Missing 'Close' column")
    
    # Calculate
    try:
        result = _calculate(data, indicator_name, **params)
        return result
    except Exception as e:
        raise DataProcessingException(
            f"Error calculating {indicator_name}: {e}"
        ) from e
```

### Signal Generation Pattern
```python
def generate_signal(stock_data: StockData) -> EntrySignal:
    """Generate entry signal from stock data."""
    # Calculate all indicators
    indicators = calculate_all_indicators(stock_data.history)
    
    # Score the signal
    score = calculate_signal_score(indicators, stock_data)
    
    # Determine signal type
    signal_type = determine_signal_type(score)
    
    # Calculate risk metrics
    risk_metrics = calculate_risk_metrics(stock_data, indicators)
    
    return EntrySignal(
        symbol=stock_data.symbol,
        signal_type=signal_type,
        score=score,
        confidence=calculate_confidence(indicators),
        entry_price=stock_data.history['Close'].iloc[-1],
        stop_loss=risk_metrics.stop_loss,
        take_profit=risk_metrics.take_profit
    )
```

