### Data Validation
```python
@dataclass
class StockData:
    symbol: str
    history: pd.DataFrame
    
    def __post_init__(self):
        """Validate data after initialization."""
        if not isinstance(self.symbol, str) or not self.symbol:
            raise ValueError("symbol must be non-empty string")
        if self.history.empty:
            raise ValueError("history DataFrame cannot be empty")
        required_columns = ['Open', 'High', 'Low', 'Close', 'Volume']
        if not all(col in self.history.columns for col in required_columns):
            raise ValueError(f"history must contain columns: {required_columns}")
```

## Parallel Processing Guidelines

### Thread Pool for I/O-Bound Operations
```python
from concurrent.futures import ThreadPoolExecutor, as_completed
from typing import List, Dict

def analyze_batch_parallel(symbols: List[str], max_workers: int = 10) -> Dict[str, StockData]:
    """Analyze multiple stocks in parallel."""
    results = {}
    
    with ThreadPoolExecutor(max_workers=max_workers) as executor:
        # Submit all tasks
        future_to_symbol = {
            executor.submit(analyze_stock, symbol): symbol
            for symbol in symbols
        }
        
        # Collect results as they complete
        for future in as_completed(future_to_symbol):
            symbol = future_to_symbol[future]
            try:
                results[symbol] = future.result()
            except Exception as e:
                DebugUtils.log_error(e, f"Error analyzing {symbol}")
                results[symbol] = None
    
    return results
```

### Process Pool for CPU-Bound Operations
```python
from concurrent.futures import ProcessPoolExecutor

def calculate_indicators_parallel(data_list: List[pd.DataFrame]) -> List[Dict]:
    """Calculate indicators in parallel for multiple stocks."""
    with ProcessPoolExecutor(max_workers=cpu_count()) as executor:
        results = list(executor.map(calculate_all_indicators, data_list))
    return results
```

### Rate Limiting
```python
import time
from threading import Semaphore

class RateLimiter:
    def __init__(self, max_calls: int, period: float):
        self.max_calls = max_calls
        self.period = period
        self.calls = []
        self.semaphore = Semaphore(max_calls)
    
    def __call__(self, func):
        def wrapper(*args, **kwargs):
            with self.semaphore:
                now = time.time()
                # Remove old calls outside period
                self.calls = [t for t in self.calls if now - t < self.period]
                
                if len(self.calls) >= self.max_calls:
                    sleep_time = self.period - (now - self.calls[0])
                    if sleep_time > 0:
                        time.sleep(sleep_time)
                
                self.calls.append(time.time())
                return func(*args, **kwargs)
        return wrapper
```

